{
  "title": "Podcast Ad",
  "summary": "Displays a podcast player for the latest episode or a specific episode.",
  "pages": [
    {
      "id": "overview",
      "title": "Overview",
      "file": "overview.md"
    },
    {
      "id": "settings",
      "title": "Settings",
      "file": "settings.md"
    },
    {
      "id": "faq",
      "title": "FAQ",
      "file": "faq.md"
    }
  ],
  "examples": [
    {
      "title": "Latest episode, major player",
      "attributes": {
        "display-mode": "latest",
        "player-size": "large"
      },
      "resolve": [
        "podcast-id"
      ]
    },
    {
      "title": "A specific episode, a small player",
      "attributes": {
        "display-mode": "specific",
        "player-size": "small"
      },
      "resolve": [
        "podcast-id",
        "episode-id"
      ]
    }
  ]
}
